{
  "name": "sherlock-skill",
  "version": "0.4.1",
  "description": "Agent-neutral public username discovery with bounded pivot rounds, account linkage verification, and integrated report generation.",
  "instructions": {
    "skill": "SKILL.md",
    "agents": "AGENTS.md",
    "identity_rules": "references/identity-verification.md",
    "pivot_rules": "references/pivot-discovery.md"
  },
  "output": {
    "default_language": "English",
    "change_requires_explicit_request": true,
    "conversation_language_is_artifact_language": false,
    "report_template": "assets/report_template.md"
  },
  "runtime": {
    "language": "python",
    "minimum_version": "3.10",
    "dependencies": [],
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "authentication": {
    "required": false,
    "api_key_required": false
  },
  "network": {
    "required_for_scans": true,
    "proxy_schemes": [
      "http",
      "https"
    ]
  },
  "entrypoints": {
    "scan": {
      "command": [
        "python",
        "scripts/sherlock_scan.py",
        "scan"
      ],
      "required_arguments": [
        "--username"
      ],
      "output": "JSON"
    },
    "collect_report": {
      "command": [
        "python",
        "scripts/username_analysis.py",
        "collect"
      ],
      "required_arguments": [
        "--username"
      ],
      "output": "username_analysis/<safe-username>/ with English Markdown by default, evidence, and scan files"
    },
    "validate_report": {
      "command": [
        "python",
        "scripts/username_analysis.py",
        "validate"
      ],
      "required_arguments": [
        "report path"
      ],
      "output": "validation status"
    },
    "validate_site_data": {
      "command": [
        "python",
        "scripts/sherlock_scan.py",
        "validate-data"
      ],
      "required_arguments": [],
      "output": "JSON"
    }
  }
}
